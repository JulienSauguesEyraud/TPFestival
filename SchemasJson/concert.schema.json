{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "genre_musical": {
      "type": "string"
    },
    "date_debut": {
      "type": "string",
      "format": "date"
    },
    "date_fin": {
      "type": "string",
      "format": "date"
    },
    "statut": {
      "type": "string",
      "enum": [
        "en cours",
        "annulé",
        "terminé"
      ]
    },
    "scene_id": {
      "type": "integer"
    },
    "artiste_id": {
      "type": "integer"
    }
  },
  "required": [
    "id",
    "genre_musical",
    "date_debut",
    "date_fin",
    "statut",
    "scene_id",
    "artiste_id"
  ]
}