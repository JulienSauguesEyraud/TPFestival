{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "oneOf": [
    {
      "properties": {
        "type": {
          "const": "artiste"
        },
        "id": {
          "type": "integer"
        },
        "nom_artiste": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "id",
        "nom_artiste"
      ],
      "additionalProperties": false
    },
    {
      "properties": {
        "type": {
          "const": "scene"
        },
        "id": {
          "type": "integer"
        },
        "nom_scene": {
          "type": "string"
        },
        "adresse": {
          "type": "string"
        },
        "capacite": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "type",
        "id",
        "nom_scene",
        "adresse",
        "capacite"
      ],
      "additionalProperties": false
    },
    {
      "properties": {
        "type": {
          "const": "concert"
        },
        "id": {
          "type": "integer"
        },
        "genre_musical": {
          "type": "string"
        },
        "date_debut": {
          "type": "string",
          "format": "date-time"
        },
        "date_fin": {
          "type": "string",
          "format": "date-time"
        },
        "statut": {
          "type": "string",
          "enum": [
            "à venir",
            "en cours",
            "annulé",
            "terminé"
          ]
        },
        "scene_id": {
          "type": "integer"
        },
        "artiste_id": {
          "type": "integer"
        }
      },
      "required": [
        "type",
        "id",
        "genre_musical",
        "date_debut",
        "date_fin",
        "statut",
        "scene_id",
        "artiste_id"
      ],
      "additionalProperties": false
    },
    {
      "properties": {
        "type": {
          "const": "billet"
        },
        "code": {
          "type": "string",
          "pattern": "^[0-9]{12}$"
        },
        "prix": {
          "type": "number",
          "minimum": 0
        },
        "date_achat": {
          "type": "string",
          "format": "date"
        },
        "consomme": {
          "type": "boolean"
        },
        "acheteur": {
          "type": "object",
          "properties": {
            "nom": {
              "type": "string"
            },
            "prenom": {
              "type": "string"
            },
            "mail": {
              "type": "string",
              "format": "email"
            }
          },
          "required": [
            "nom",
            "prenom",
            "mail"
          ],
          "additionalProperties": false
        },
        "concert_id": {
          "type": "integer"
        }
      },
      "required": [
        "type",
        "code",
        "prix",
        "date_achat",
        "consomme",
        "acheteur",
        "concert_id"
      ],
      "additionalProperties": false
    }
  ]
}